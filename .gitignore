# 依赖与构建产物
node_modules/
dist/

# 测试工作目录（数据副本 / 截图 / 独立的 userData），跑 e2e 时会自动建
.e2e-work/
.selftest-userdata/

# 运行期生成（Electron 与显卡驱动会在 cwd 下落缓存）
NVIDIA Corporation/

# 本地调试产物
# logs/ 由启动脚本与主进程共同读写: launch.log(启动日志) + ready.flag(就绪标记)
logs/
*.log

# 本机专属配置（Electron 运行时位置 / 数据目录 / 旧版工具根目录）
# 模板见 local.config.example.json
local.config.json

# 运行时用户目录（旧的 user/ + 数据目录路由后的 user/）：里面全是本机路径
user/

# 在线封面下载器的凭据（booru_auth.exe / booru_auth.json）—— 绝不入库
booru_auth*

# 引导安装器的构建产物（build-bootstrap.cjs 每次重新渲染；日志含本机绝对路径）
tools/bootstrap-installer/build/

# 绿色分发包产物（scripts/pack-green.mjs 的输出）
release/
# 打包时的临时输出目录（electron-builder -c.directories.output=releaseXXX）
/release*/

# 使用教程视频工程（Remotion）
.video-tools/
tutorial-video/node_modules/
tutorial-video/out/

# ---------------- 数据目录 ----------------
# data/ 默认不进仓库：
#   · 用户数据(绝不出机器): 黑名单 / 替换规则 / 背景补全 / 收藏备注 / 购物车历史 /
#     扫描文件夹记录 / 缩略图缓存      —— 里面全是本机文件路径
#   · 可再生派生物: tags.db(由标签 txt 同步生成) / scan_cache.json(重扫即可重建)
#   · 大体积模型: models/(4GB, ONNX tagger 模型, 用户首跑时自行下载)
#   · 知识类放行(2026-10-20 起随仓库分发, 给用户开箱即用的翻译/角色库):
#     - local_translations.json   标签中文翻译(WeiLin 合并 + AI 补译, ~9000 条)
#     - character_library.json    角色库(名称/系列/别名映射)
#     - user_meta.json            角色分类
#     三者均为"知识"而非本机路径, 不含用户隐私; 后续更新随正常提交走
# 只放行 *.example.json 模板与上述三个知识文件 —— 用 data/* 而不是 data/，这样否定规则才生效
data/*
!data/*.example.json
!data/character_library.json
!data/local_translations.json
!data/user_meta.json

# 测试夹具的产物（图片由 test-fixtures/make_scan_test.py 生成）
test-fixtures/scan-test/

# Python 字节码（跑一次 test-fixtures/make_scan_test.py 就会生成）
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
*.tmp

# 内部交接记录与规划文档（不是给用户看的文档，开源前不进仓库）
# 这类文档含有本机真实路径与私有目录名，对外分发前需要先脱敏
交接日志.md
docs/数据源合并与增量入库方案.md

# 运行期缓存(扫描页目录快照; 可再生, 与 data/scan_cache.json 同性质)
cache/

# 另一个项目的工程(Remotion 教程视频), 含 node_modules —— 不属于本仓库
tutorial-video/

# 根目录的孤儿数据库(测试残留); 真正的库在 data/tags.db, 已由 data/* 覆盖
/tags.db

# SQLite 边车文件(活库运行时产生, 任何位置都不入库)
*.db-shm
*.db-wal

# 介绍片制作工程(935MB): pptx/音频/录屏/中间产物, 只留最终成片走 release
docs/video/
