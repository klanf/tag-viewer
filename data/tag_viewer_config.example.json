{
  // ============================================================
  // 标签数据源配置 —— 模板
  // 用法: 复制到「数据目录」下并改名为 tag_viewer_config.json
  //       (数据目录在应用启动日志里会打印, 默认是 <userData>/data;
  //        用「打开数据目录」菜单项可以直接跳过去)
  // 本文件里的注释是允许的: 读取时会先去掉以 // 开头的整行。
  // ============================================================

  // ---- 方式一(推荐): 多来源模式 ----
  // 扫描该目录下所有 tags_*.txt, 每个文件算一个"来源",
  // 来源名 = 文件名去掉 tags_ 前缀和 .txt 后缀。
  "data_files_dir": "D:/你的标签文件目录",

  // ---- 方式二: 单个汇总文件(与方式一互斥, 方式一优先) ----
  "data_file": "",

  // ---- 方式三: 显式列出多个来源 ----
  // 对象写法 {"来源名": "文件路径"} 或数组写法 ["路径1", "路径2"] 都支持
  "data_files": {},

  // translate_dir: 标签翻译数据目录(含有 userdatas_zh_CN_*.db)。
  //   - 留空 ""  (推荐): 自动在「数据目录」下找 weilin_data* 目录。
  //     也就是说把 weilin_data(...) 整个丢进数据目录就能用, 不用在这里写绝对路径。
  //   - 填绝对路径: 明确指定用哪个目录(路径失效时会自动回落到上面的自动发现,
  //     并在 launch.log 里记一条 warn —— 不会静默变成"没有翻译")
  //   - 两种都找不到: 不启用翻译, 界面只显示英文标签
  "translate_dir": "",

  // 旧版 HTTP 接口用的端口, 仅历史兼容, 新架构不用
  "port": 8080
}
