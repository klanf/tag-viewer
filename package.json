{
  "name": "tag-viewer-electron",
  "productName": "TagViewer",
  "version": "2.0.0",
  "private": true,
  "description": "WD14 标签可视化看板 —— Electron + Vue 3 重构版",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "setup:electron": "node scripts/link-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/preflight.mjs",
    "check:templates": "node scripts/check-templates.mjs",
    "build": "node scripts/preflight.mjs && vite build",
    "start": "node scripts/run.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/preflight.mjs && vite build && node scripts/e2e.mjs",
    "search:check": "node scripts/search-check.mjs",
    "prune:dist": "node scripts/prune-dist.mjs",
    "prune:dist:apply": "node scripts/prune-dist.mjs --apply",
    "selftest": "node scripts/selftest.mjs",
    "test:ipc": "node scripts/test-ipc-ctxmenu.mjs",
    "test:transfer": "node scripts/test-fileTransfer.mjs",
    "test:db-safety": "node scripts/test-db-safety.mjs",
    "test:nodata": "node scripts/test-nodata-boot.mjs",
    "test:translate": "node scripts/test-translate-dir.mjs",
    "test:paths": "node scripts/check-paths.mjs",
    "test:layout": "node scripts/test-data-layout.mjs",
    "test:ingest": "node scripts/test-ingest.mjs",
    "test:tagger": "node scripts/test-tagger.mjs",
    "test:folders": "node scripts/test-folders.mjs",
    "folders:export": "node scripts/folders-export.mjs",
    "data:backup": "node scripts/db-backup.mjs",
    "data:migrate": "node scripts/data-migrate.mjs",
    "data:audit": "node scripts/data-migrate.mjs --audit",
    "data:lint": "node scripts/data-lint.mjs",
    "data:plan": "node scripts/data-migrate.mjs --dry-run",
    "db:info": "node scripts/db.mjs info",
    "ingest": "node scripts/ingest.mjs",
    "ingest:plan": "node scripts/ingest.mjs --plan",
    "tagger": "node scripts/tagger.mjs",
    "tagger:status": "node scripts/tagger.mjs --status",
    "db:import": "node scripts/db.mjs import",
    "db:import:force": "node scripts/db.mjs import --force",
    "db:export": "node scripts/db.mjs export",
    "db:reset": "node scripts/db.mjs reset",
    "db:verify": "node scripts/db.mjs verify",
    "postinstall": "node scripts/link-electron.mjs --quiet"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "44.3.0",
    "vite": "^7.0.0"
  }
}
