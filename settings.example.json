{
  // ============================================================
  // 应用设置 —— **说明文档**, 不是给程序读的文件
  // ============================================================
  // 真实的设置文件位置: <userData>/settings.json
  //   Windows: %APPDATA%\TagViewer\settings.json
  //
  // 正常情况下不需要手改 —— 应用会自己写入和维护它。
  // 本文件用来说明有哪些字段、各自什么含义。键名是白名单,
  // 渲染进程塞进来的多余字段会被丢弃(见 electron/core/workspace.js 的 saveSettings)。
  //
  // ⚠️ settings.json 是**严格 JSON**: 真的去手改那个文件时,
  //    必须把注释删掉, 否则解析失败会被当成"没有设置"而静默回落默认值。
  //    (标签数据源的 tag_viewer_config.json 不一样, 那个允许 // 整行注释)
  // ============================================================

  // 数据目录: 黑名单/替换规则/收藏/购物车历史/缩略图缓存/标签库都放这儿。
  // 留空或删除则回落到环境变量 TV_DATA_DIR, 再回落到 <userData>/data。
  "dataDir": "",

  // 标签数据源配置文件路径。留空则用 <dataDir>/tag_viewer_config.json
  "configPath": "",

  // 上次在"选择文件夹"对话框里停留的目录(纯记忆用, 不影响功能)
  "lastPickDir": "",

  // 右键「📤 移动到」的预设文件夹, 最多 50 条, 按路径去重
  "quickFolders": [
    { "name": "示例", "path": "D:/你的常用目录" }
  ],

  // 首次启动引导是否已完成(留给设置页/向导使用)
  "firstRunDone": false
}
